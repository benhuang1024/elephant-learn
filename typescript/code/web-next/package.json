  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "@ts/eslint-config": "workspace:*"
  }
